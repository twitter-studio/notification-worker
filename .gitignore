node_modules/
dist/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
coverage/
*.log
# wrangler は .dev.vars がないと .env 系を手元の秘密として読む。
.env
.env.*
!.env.example
# 利用者が wrangler.jsonc から作る、自分の設定 (自分の Worker の名前や URL を入れる)。
# wrangler.jsonc (ボタンの設定) と wrangler.example.jsonc (基本の設定) のほかは、手元の設定としてコミットしない。
/wrangler.*.json*
!/wrangler.example.jsonc

# GitHub Environmentの変数から一時生成する配置設定。
.sandbox-deploy-*.jsonc
