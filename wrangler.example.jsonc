// 利用者の Worker の基本の設定 (型、試験、build の正本)。端末の接続 (Durable Object) は含まないので、配置には使わない。
// 自分で配置するときは、端末の接続も含む `wrangler.jsonc` を `wrangler.local.jsonc` に写して使う (README)。
// 秘密 (RELAY_TOKEN、MOCK_WEBHOOK_SECRET) は、ここに書かず、`wrangler secret put` で置く。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 自分の Worker の名前 (自分の Cloudflare のアカウントの中で決める)。
  "name": "notification-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Wrangler の利用状況を Cloudflare に送らない。
  "send_metrics": false,
  // 版ごとの URL (Version URL) を作らない。試すために模擬の入口を有効にした版が、版の URL で開いたまま残らないように。
  // デプロイのとき、wrangler が「Preview URLs も有効にしては」と警告するが、無視してよい。
  "preview_urls": false,
  "vars": {
    // 運営の通知の中継 API の URL (https、パスなし)。端末を登録した中継と同じにする (本番は https://notification-service-production.zunda-dev.workers.dev)。
    "RELAY_URL": "https://relay.example.invalid",
    // 模擬のイベントの入口 (POST /webhooks/mock)。試すときだけ "true" にし、MOCK_WEBHOOK_SECRET を置く。
    "ENABLE_MOCK_EVENTS": "false",
    // X の Webhook の入口 (POST /webhooks/x)。実際の接続と費用の承認を得て設定するまで "false" のまま。
    "ENABLE_X_ACTIVITY": "false",
    // X でログインして接続する (ADR-0008 の段 3) ときの、自分の X アプリの OAuth 2.0 の Client ID。空なら /connect を出さない。
    "X_OAUTH2_CLIENT_ID": "",
    // X でログインして接続してよい X ユーザーの数値 ID。カンマ区切り。
    "ALLOWED_X_USER_IDS": ""
    // 任意の変数は置かない (ボタンの配置の画面がどれも必須の欄にするため。#59)。要るときに足す:
    // X_USER_ID: 手で配送先を設定するときの、OAuth 認可した本人の X ユーザー ID。
    // X_WEBHOOK_ID: 接続のときに作る購読を付ける Webhook の ID。なければ、`/setup` で用意した Webhook を使う。
  },
  "queues": {
    "producers": [{ "binding": "X_EVENTS", "queue": "notification-x-events" }],
    "consumers": [
      {
        "queue": "notification-x-events",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1
      }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
